# Copy to .env and fill in real values. Never commit .env (it is git-ignored).

# --- LLM PROVIDER SWITCH ---
# Explicitly pick the chat provider (wins even when several API keys are set):
#   google | openrouter | anthropic | openai | vertex
# Leave unset for auto-detect (first configured key wins, Google first).
LLM_PROVIDER=openrouter

# --- OPENROUTER (multi-model: any slug from https://openrouter.ai/models) ---
OPENROUTER_API_KEY=
# Agent model (system under test)
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- JUDGE MODEL (LLM-as-judge graders) ---
# Defaults to LLM_PROVIDER when unset. JUDGE_MODEL is required for model graders
# and should differ from the agent model (otherwise the run is flagged "self-judged").
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=
JUDGE_TEMPERATURE=0

# --- SIMULATOR MODEL (simulated user for multi-turn evals) ---
# Both default to the agent provider/model when unset.
SIMULATOR_PROVIDER=openrouter
SIMULATOR_MODEL=openai/gpt-4o-mini

# --- LANGSMITH TRACING (LLM observability) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=eval-engineering
# Legacy aliases (older langchain versions read these names)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=eval-engineering

# --- WEB SEARCH (web_search tool; falls back to DuckDuckGo when empty) ---
TAVILY_API_KEY=

# --- STORAGE ---
# Default: SQLite at <repo>/data/eval_harness.db (leave unset). Relative sqlite paths resolve from the repo root.
# Postgres: DATABASE_URL=postgresql+psycopg://evalh:evalh@localhost:5432/evalh   (uv sync --extra postgres)
# DATABASE_URL=
